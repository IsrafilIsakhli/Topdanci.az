NODE_ENV=development
PORT=4000

# Local database used by docker-compose.
POSTGRES_USER=topdanbazar
POSTGRES_PASSWORD=topdanbazar
POSTGRES_DB=topdanbazar
DATABASE_URL=postgresql://topdanbazar:topdanbazar@localhost:5433/topdanbazar?schema=public

# Redis is required for rate limits, cache, and media worker queues.
REDIS_URL=redis://localhost:6379

# Use strong unique values in production. Minimum 32 characters.
JWT_ACCESS_SECRET=change-me-with-a-strong-access-secret
JWT_REFRESH_SECRET=change-me-with-a-strong-refresh-secret
LEAD_HASH_SALT=change-me-with-a-strong-lead-hash-salt
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900

# Origins and API URLs.
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
API_INTERNAL_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CDN_BASE_URL=

# Public catalog runs independently by default. Enable live data only after a
# stable API host has been connected.
NEXT_PUBLIC_ENABLE_LIVE_CATALOG=false
# false → when the API is unreachable, catalog pages render empty instead of demo data.
NEXT_PUBLIC_ENABLE_DEMO_FALLBACK=true

# Production frontend example:
# WEB_ORIGIN=https://topdanci-az.vercel.app
# NEXT_PUBLIC_ENABLE_LIVE_CATALOG=false
# AUTH_COOKIE_SAME_SITE=lax
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_DOMAIN=

# Production seed creates only categories and this superadmin.
# Use a unique password with at least 16 characters and rotate it after first login.
TOPDANBAZAR_SUPERADMIN_EMAIL=
TOPDANBAZAR_SUPERADMIN_PASSWORD=
# Demo seed is blocked in production unless this exact acknowledgement is set.
ALLOW_PRODUCTION_DEMO_SEED=

# Media upload/CDN. Required in production when NODE_ENV=production.
AWS_S3_BUCKET=topdanbazar-local
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CDN_BASE_URL=
MEDIA_WORKER_ENABLED=true
MEDIA_WORKER_CONCURRENCY=2

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
API_BODY_LIMIT=256kb
REQUEST_TIMEOUT_MS=15000
METRICS_TOKEN=replace-with-private-metrics-token
