{
  "name": "topdanbazar",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace @topdanbazar/web",
    "dev:api": "npm run start:dev --workspace @topdanbazar/api",
    "build": "npm run build:api && npm run build:web",
    "build:web": "npm run build --workspace @topdanbazar/web",
    "build:api": "npm run build --workspace @topdanbazar/api",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @topdanbazar/api",
    "verify": "npm run lint && npm run prisma:validate && npm run typecheck && npm run test && npm run test:e2e && npm run build && node scripts/audit-gate.cjs",
    "verify:local": "node scripts/check-local-services.cjs && npm run prisma:deploy && npm run prisma:seed && npm run verify",
    "smoke:production": "node scripts/production-smoke.cjs",
    "check:local-services": "node scripts/check-local-services.cjs",
    "db:backup": "node scripts/postgres-backup.cjs",
    "db:restore:staging": "node scripts/postgres-restore.cjs",
    "prisma:generate": "npm run prisma:generate --workspace @topdanbazar/api",
    "prisma:validate": "npm run prisma:validate --workspace @topdanbazar/api",
    "prisma:deploy": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "prisma:migrate": "npm run prisma:migrate --workspace @topdanbazar/api",
    "prisma:seed": "npm run prisma:seed --workspace @topdanbazar/api",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\""
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "multer": "^2.2.0",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "deepmerge-ts": "^8.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nestjs/testing": "^11.1.19",
    "@types/supertest": "^7.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^15.5.18",
    "globals": "^16.5.0",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.5"
  }
}
