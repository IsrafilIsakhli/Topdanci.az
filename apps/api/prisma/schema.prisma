generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum StoreRole {
  OWNER
  MANAGER
  STAFF
}

enum StoreStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CategoryStatus {
  ACTIVE
  PASSIVE
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PASSIVE
  REJECTED
  DELETED
}

enum PriceType {
  FIXED
  NEGOTIABLE
}

enum ProductUnit {
  PIECE
  BOX
  KG
  TON
  METER
  PACKAGE
}

enum ImageStatus {
  UPLOADING
  READY
  FAILED
  DELETED
}

enum LeadType {
  WHATSAPP_CLICK
  PHONE_REVEAL
  EMAIL_CLICK
  STORE_VIEW
  PRODUCT_VIEW
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

model User {
  id              String    @id @default(cuid())
  email           String?   @unique
  phone           String?   @unique
  passwordHash    String?
  fullName        String?
  role            UserRole  @default(BUYER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  storeMembers       StoreMember[]
  refreshSessions    RefreshSession[]
  leadEvents         LeadEvent[]
  reports            Report[]           @relation("ReportReporter")
  auditLogs          AuditLog[]         @relation("AuditActor")
  ownedStores        Store[]            @relation("StoreOwner")
  reviewedStores     Store[]            @relation("StoreReviewer")
  reviewedApplications StoreApplication[] @relation("ApplicationReviewer")
  reviewedProducts   Product[]          @relation("ProductReviewer")
  accountSetupTokens AccountSetupToken[]

  @@index([role, status])
  @@map("users")
}

model AccountSetupToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@index([expiresAt])
  @@map("account_setup_tokens")
}

model RefreshSession {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  ipHash        String?
  userAgentHash String?
  expiresAt     DateTime
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model StoreApplication {
  id           String            @id @default(cuid())
  contactName  String
  contactPhone String
  contactEmail String?
  companyName  String
  taxNumber    String?
  categoryId   String?
  city         String
  district     String?
  description  String?
  status       ApplicationStatus @default(PENDING)
  reviewNote   String?
  reviewedAt   DateTime?
  reviewedById String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reviewedBy User?     @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([categoryId])
  @@map("store_applications")
}

model Store {
  id              String      @id @default(cuid())
  ownerUserId     String?
  reviewedById    String?
  categoryId      String?
  slug            String      @unique
  name            String
  legalName       String?
  taxNumber       String?     @unique
  description     String?
  status          StoreStatus @default(PENDING)
  logoKey         String?
  bannerKey       String?
  phone           String?
  whatsappNumber  String?
  email           String?
  city            String
  district        String?
  address         String?
  workingHours    Json?
  verifiedAt      DateTime?
  publishedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  ownerUser  User?     @relation("StoreOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  reviewedBy User?     @relation("StoreReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  members    StoreMember[]
  products   Product[]
  leadEvents LeadEvent[]
  reports    Report[]

  @@index([status, city])
  @@index([categoryId, status])
  @@index([publishedAt])
  @@map("stores")
}

model StoreMember {
  id        String    @id @default(cuid())
  storeId   String
  userId    String
  role      StoreRole @default(STAFF)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId, role])
  @@map("store_members")
}

model Category {
  id          String         @id @default(cuid())
  parentId    String?
  slug        String         @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int            @default(0)
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  parent            Category?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children          Category[]         @relation("CategoryTree")
  products          Product[]
  stores            Store[]
  storeApplications StoreApplication[]

  @@index([parentId, status, sortOrder])
  @@map("categories")
}

model Product {
  id               String        @id @default(cuid())
  storeId          String
  categoryId       String?
  slug             String        @unique
  title            String
  description      String?
  price            Decimal?      @db.Decimal(12, 2)
  priceType        PriceType     @default(NEGOTIABLE)
  currency         String        @default("AZN")
  unit             ProductUnit   @default(PIECE)
  minOrderQuantity Decimal?      @db.Decimal(12, 2)
  stockStatus      String        @default("IN_STOCK")
  status           ProductStatus @default(DRAFT)
  reviewNote       String?
  reviewedAt       DateTime?
  reviewedById     String?
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  store      Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category   Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reviewedBy User?          @relation("ProductReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  images     ProductImage[]
  leadEvents LeadEvent[]
  reports    Report[]

  @@unique([storeId, slug])
  @@index([status, publishedAt])
  @@index([status, title])
  @@index([categoryId, status])
  @@index([storeId, status])
  @@index([reviewedById])
  @@map("products")
}

model ProductImage {
  id         String      @id @default(cuid())
  productId  String
  storageKey String
  cdnUrl     String?
  altText    String?
  sortOrder  Int         @default(0)
  width      Int?
  height     Int?
  mimeType   String
  sizeBytes  Int
  variants   Json?
  failureReason String?
  blurHash   String?
  status     ImageStatus @default(UPLOADING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([status])
  @@map("product_images")
}

model LeadEvent {
  id            String   @id @default(cuid())
  type          LeadType
  storeId       String
  productId     String?
  userId        String?
  anonymousId   String?
  source        String?
  ipHash        String?
  userAgentHash String?
  referrer      String?
  createdAt     DateTime @default(now())

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([storeId, type, createdAt])
  @@index([productId, type, createdAt])
  @@index([anonymousId, createdAt])
  @@map("lead_events")
}

model Report {
  id         String       @id @default(cuid())
  reporterId String?
  storeId    String?
  productId  String?
  type       String
  message    String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  reporter User?    @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  store    Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([storeId])
  @@index([productId])
  @@map("reports")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  action       String
  resourceType String
  resourceId   String
  metadata     Json?
  createdAt    DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
